# === LLM Configuration ===
# Get your API key from: https://platform.openai.com/api-keys
# For Groq: https://console.groq.com/keys
# For local models with Ollama: use base_url=http://localhost:11434/v1 and any dummy key
JARVIS_LLM_API_KEY=your-api-key-here
JARVIS_LLM_BASE_URL=https://api.openai.com/v1
JARVIS_LLM_MODEL=gpt-4o-mini

# === Voice Settings ===
JARVIS_TTS_ENABLED=true
JARVIS_VOICE_INPUT_ENABLED=true

# === Personality ===
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Sir
JARVIS_PERSONALITY=You are Jarvis, a sophisticated AI assistant inspired by the one from Iron Man. You are polite, witty, and efficient. Address the user as "Sir" unless told otherwise. Keep responses concise and helpful. You have a dry sense of humor but always prioritize being useful.

# === System ===
JARVIS_LOG_LEVEL=INFO
